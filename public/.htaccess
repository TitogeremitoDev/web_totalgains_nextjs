# ── Routing Next.js estático ─────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 410 Gone — APK eliminado
    Redirect 410 /TotalGains.apk

    # 301 rutas en inglés que los agentes prueban por convención.
    # La página existe, pero vive en /sobre-nosotros/: sin esto, un agente que
    # comprueba /about para verificar que el negocio es real recibe un 404.
    Redirect 301 /about /sobre-nosotros/
    Redirect 301 /about/ /sobre-nosotros/
    Redirect 301 /about-us /sobre-nosotros/
    Redirect 301 /about-us/ /sobre-nosotros/

    # 301 redirects — blogs antiguos sin contenido actual
    Redirect 301 /blog/app-entrenamiento-personalizado /blog/ia-entrenador-personal-rutinas-dietas/
    Redirect 301 /blog/app-entrenamiento-personalizado/ /blog/ia-entrenador-personal-rutinas-dietas/
    Redirect 301 /blog/gestion-clientes-entrenador-personal /gestion-clientes-fitness/
    Redirect 301 /blog/gestion-clientes-entrenador-personal/ /gestion-clientes-fitness/

    # 301 consolidación de Harbiz (27-sep-2026). El post declaraba canonical a
    # /alternativas/harbiz/precios/ desde el 11-ago, pero Google lo siguió
    # indexando por su cuenta (Search Console: «La URL está en Google»).
    # Reversible: quitar estas dos líneas y volver a publicar el post.
    Redirect 301 /blog/harbiz-precios-2026 /alternativas/harbiz/precios/
    Redirect 301 /blog/harbiz-precios-2026/ /alternativas/harbiz/precios/

    # Página de contacto con la ruta en inglés que prueban los agentes. Con
    # RewriteRule y no con Redirect: «Redirect /contact» también cazaría
    # /contacto/ (Redirect compara por el principio de la ruta).
    RewriteRule ^contact/?$ /contacto/ [R=301,L]

    # Markdown para agentes de IA (31-oct-2026): si piden «Accept: text/markdown»
    # se les da el index.md de la misma página, que crea scripts/markdown-agentes.mjs
    # tras el build. La respuesta va con no-store (ver «Markdown para agentes» más
    # abajo): Cloudflare no separa las copias por Accept y una copia en Markdown
    # nunca puede acabar sirviéndose a una persona.
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_URI} /$
    RewriteCond %{REQUEST_FILENAME}/index.md -f
    RewriteRule ^(.*)$ /$1index.md [L]

    # Añadir trailing slash a rutas sin extensión
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteRule ^(.+)$ /$1/ [R=301,L]

    # Servir index.html para directorios
    DirectoryIndex index.html
    Options -Indexes
</IfModule>

# ── Página de error propia ───────────────────────────────────────────────────
# Sin esto, una URL rota devuelve el 404 genérico de Hostinger, en ingles y sin
# salidas. El 404.html que exporta Next SI existe en el servidor y se sirve bien
# si lo pides directo, pero Apache no lo usaba porque nadie se lo habia dicho.
# Va FUERA de cualquier <IfModule>: ErrorDocument es del core de Apache.
ErrorDocument 404 /404.html

# ── Compresión ──────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ── Cache-Control ────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(woff2|woff)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── Estado de la oferta para la app (src/app/oferta-web.json) ────────────────
# La app la lee desde el móvil y desde su web; en desarrollo (localhost) el
# navegador necesita este permiso. Caché corta: si se cierra la oferta, la app
# tiene que enterarse enseguida.
<IfModule mod_headers.c>
    <Files "oferta-web.json">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=300"
    </Files>
</IfModule>

# ── Markdown para agentes ────────────────────────────────────────────────────
# Las versiones .md de cada página (ver el RewriteRule de arriba): nunca en caché
# compartida, fuera de Google (el original es el HTML) y avisando de que la
# respuesta cambia según lo que pida el cliente.
<IfModule mod_mime.c>
    AddType text/markdown .md
    AddCharset utf-8 .md
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.md$">
        Header set Cache-Control "no-store, private"
        Header set X-Robots-Tag "noindex"
        Header set Vary "Accept"
    </FilesMatch>
</IfModule>

# ── La portada anuncia a los agentes lo que tienen hecho para ellos (RFC 8288) ─
# El fichero para IAs y la versión en Markdown de la portada.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(index\.html)?$" PORTADA=1
</IfModule>
<IfModule mod_headers.c>
    Header add Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\"" env=PORTADA
    Header add Link "</index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=PORTADA
</IfModule>

# ── Tipos MIME correctos ─────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

# ── Seguridad básica ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── App autenticada — NO indexar en SEO ni AI ────────────────────────────────
# SetEnvIf SÍ funciona en .htaccess (al contrario que LocationMatch).
# Marca solo las URLs /app/ y /api/ con env, y luego aplica X-Robots-Tag a esas.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/app/" NOINDEX_APP=1
    SetEnvIf Request_URI "^/api/"  NOINDEX_API=1
</IfModule>

<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" env=NOINDEX_APP
    Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX_API
</IfModule>
